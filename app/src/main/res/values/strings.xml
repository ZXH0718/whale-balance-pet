<resources>
    <string name="app_name">鲸鱼娘余额桌宠</string>
    <string name="bubble_placeholder">余额 --</string>
    <string name="section_intro">把鲸鱼娘放在屏幕角落，常显 DeepSeek 账户余额。拖拽移动、松手自动吸附左右边缘，点一下立即刷新，长按鲸鱼打开设置。</string>
    <string name="label_key">DeepSeek API Key</string>
    <string name="hint_key">sk-...</string>
    <string name="label_interval">自动刷新间隔（秒，最小 15）</string>
    <string name="label_bubble">显示余额气泡</string>
    <string name="action_overlay">授予悬浮窗权限</string>
    <string name="action_start">保存并启动桌宠</string>
    <string name="action_stop">停止桌宠</string>
    <string name="action_check">立即查询余额</string>
    <string name="section_tips">Key 只保存在本机应用私有目录，仅用于请求 api.deepseek.com/user/balance；应用不上传任何数据。若手机厂商限制后台，请在系统设置里把本应用的后台活动 / 自启动设为允许，否则锁屏久了悬浮窗可能被系统回收。</string>
</resources>
