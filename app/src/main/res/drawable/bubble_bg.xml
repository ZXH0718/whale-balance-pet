<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 外框：深色渐变卡片 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F2151A26"
                android:startColor="#F2262E44"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#6E8FA6D8" />
        </shape>
    </item>

    <!-- 内描边：一层淡淡的高光，让卡片有厚度 -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
